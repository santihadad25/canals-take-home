# Template of the settings of `docker compose`. Copy it to `.env` (the file Compose reads) and
# edit what you need:
#
#     cp .env.example .env
#
# A variable exported in your shell wins over `.env`. The database name, user and password are
# applied the FIRST time the database is created. To change them afterwards, run
# `docker compose down -v` (it deletes the data) and start again.

# --- PostgreSQL ------------------------------------------------------------------------------
POSTGRES_USER=canals
POSTGRES_PASSWORD=canals
# The database of the application, and the one the tests use (same schema, no demo data).
POSTGRES_DB=canals
POSTGRES_TEST_DB=canals_test

# --- Ports published on your machine -------------------------------------------------------------
# Inside the Docker network the services always talk on their own fixed ports.
DB_PORT=5432
API_PORT=8000
GEOCODING_MOCK_PORT=8101
PAYMENTS_MOCK_PORT=8102

# --- API ---------------------------------------------------------------------------------------
# Worker processes of gunicorn (each one has its own threads and connection pool).
WEB_CONCURRENCY=4

# --- Where the application finds the two providers (inside the Docker network) -----------------
GEOCODING_URL=http://geocoding-mock:8000
PAYMENTS_URL=http://payments-mock:8000
